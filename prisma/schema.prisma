// =============================================================================
// Smart Queue Web System — Prisma Schema
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  phone        String?
  name         String
  passwordHash String   @map("password_hash")
  role         String   @default("MERCHANT")
  isVerified   Boolean  @default(false) @map("is_verified")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  stores Store[]

  @@map("users")
}

model Store {
  id                  String   @id @default(uuid())
  ownerId             String   @map("owner_id")
  name                String
  slug                String   @unique
  description         String?
  logoUrl             String?  @map("logo_url")
  bannerUrl           String?  @map("banner_url")
  address             String?
  latitude            Float?
  longitude           Float?
  phone               String?
  status              String   @default("PENDING")
  avgPrepTimeMins     Int      @default(10) @map("avg_prep_time_mins")
  maxConcurrentOrders Int      @default(5) @map("max_concurrent_orders")
  operatingHours      Json?    @map("operating_hours")
  qrCodeUrl           String?  @map("qr_code_url")
  paymentGateway      String?  @map("payment_gateway")
  gatewayMerchantId   String?  @map("gateway_merchant_id")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  owner              User               @relation(fields: [ownerId], references: [id])
  categories         Category[]
  menuItems          MenuItem[]
  orders             Order[]
  dailyQueueCounters DailyQueueCounter[]

  @@index([ownerId])
  @@map("stores")
}

model Category {
  id        String  @id @default(uuid())
  storeId   String  @map("store_id")
  name      String
  sortOrder Int     @default(0) @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")

  store     Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  menuItems MenuItem[]

  @@index([storeId])
  @@map("categories")
}

model MenuItem {
  id           String          @id @default(uuid())
  storeId      String          @map("store_id")
  categoryId   String?         @map("category_id")
  name         String
  description  String?
  price        Decimal         @map("price") @db.Decimal(10, 2)
  imageUrl     String?         @map("image_url")
  isAvailable  Boolean         @default(true) @map("is_available")
  prepTimeMins Int?            @map("prep_time_mins")
  sortOrder    Int             @default(0) @map("sort_order")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  store      Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category   Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  orderItems OrderItem[]

  @@index([storeId])
  @@index([categoryId])
  @@map("menu_items")
}

model Order {
  id               String    @id @default(uuid())
  storeId          String    @map("store_id")
  customerPhone    String    @map("customer_phone")
  customerName     String    @map("customer_name")
  queueNumber      Int?      @map("queue_number")
  status           String    @default("PENDING_PAYMENT")
  subtotal         Decimal   @db.Decimal(10, 2)
  tax              Decimal   @default(0) @db.Decimal(10, 2)
  total            Decimal   @db.Decimal(10, 2)
  estimatedWaitMins Int?     @map("estimated_wait_mins")
  paymentIntentId  String?   @map("payment_intent_id")
  paymentGateway   String?   @map("payment_gateway")
  paymentStatus    String    @default("PENDING") @map("payment_status")
  notes            String?
  paidAt           DateTime? @map("paid_at")
  acceptedAt       DateTime? @map("accepted_at")
  preparingAt      DateTime? @map("preparing_at")
  readyAt          DateTime? @map("ready_at")
  completedAt      DateTime? @map("completed_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  store         Store          @relation(fields: [storeId], references: [id])
  orderItems    OrderItem[]
  notifications Notification[]

  @@index([storeId])
  @@index([status])
  @@index([customerPhone])
  @@map("orders")
}

model OrderItem {
  id                  String  @id @default(uuid())
  orderId             String  @map("order_id")
  menuItemId          String  @map("menu_item_id")
  itemName            String  @map("item_name")
  itemPrice           Decimal @map("item_price") @db.Decimal(10, 2)
  quantity            Int
  lineTotal           Decimal @map("line_total") @db.Decimal(10, 2)
  specialInstructions String? @map("special_instructions")

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

model Notification {
  id             String    @id @default(uuid())
  orderId        String    @map("order_id")
  recipientPhone String    @map("recipient_phone")
  channel        String
  type           String
  status         String    @default("PENDING")
  messageBody    String    @map("message_body")
  externalId     String?   @map("external_id")
  sentAt         DateTime? @map("sent_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@map("notifications")
}

model DailyQueueCounter {
  id              String   @id @default(uuid())
  storeId         String   @map("store_id")
  queueDate       DateTime @map("queue_date")
  lastQueueNumber Int      @default(0) @map("last_queue_number")

  store Store @relation(fields: [storeId], references: [id])

  @@unique([storeId, queueDate])
  @@map("daily_queue_counters")
}
