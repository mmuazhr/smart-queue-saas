# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# Cloudflare Workers local secrets
.dev.vars
.dev.vars.*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local uploads and databases
/public/uploads/
*.db
*.db-journal

# tool caches
/.understand-anything/
.gstack/
.claude/
.superpowers/

# OpenNext / Cloudflare build output
.open-next/
.wrangler/

# git worktrees checked out inside the repo
.worktrees/

# Supabase CLI local link state
supabase/.temp/
supabase/.branches/
